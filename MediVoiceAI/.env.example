# ==============================================================
# MediVoice AI - Environment Configuration
# ==============================================================

# Application Secret Key (Used for secure session cookie signing)
SECRET_KEY=medivoice-ai-super-secret-key-2026-secure-production-random

# Database Configuration:
# - For local development: Leave blank or use sqlite:///instance/medivoice.db
# - For Vercel production: Provide a persistent cloud PostgreSQL URL
#   (e.g., from Neon, Supabase, Vercel Postgres, or CockroachDB)
#   Example: postgresql://username:password@ep-something.region.neon.tech/neondb?sslmode=require
DATABASE_URL=

# AI & OCR Vision Configuration:
# Google Gemini API Key for smart OCR verification and clinical assistance
GEMINI_API_KEY=

# Local Tesseract OCR binary path (optional; fallback clinical detector is always active)
TESSERACT_CMD=tesseract

# Flask Environment Settings
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
